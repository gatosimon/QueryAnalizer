<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Estilos compactos sobre los de ModernWpf (XamlControlsResources en App.xaml). -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding"   Value="10,2"/>
        <Setter Property="FontSize"  Value="12"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding"   Value="8,2"/>
        <Setter Property="FontSize"  Value="12"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding"   Value="8,2"/>
        <Setter Property="FontSize"  Value="12"/>
        <!-- ModernWpf alinea los combos a la izquierda; en estas ventanas llenan su celda -->
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- CheckBox y RadioButton propios: misma caja de 18 px en toda la aplicacion y texto siempre centrado con la caja
         (en los de ModernWpf el texto queda mas arriba cuando se les saca el relleno superior) -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinWidth"  Value="0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding"   Value="8,0,0,0"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Raiz" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Caja" Width="18" Height="18" CornerRadius="5" BorderThickness="1.2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BrushInputBG}" BorderBrush="{DynamicResource BrushFGMuted}">
                            <Grid>
                                <Path x:Name="Marca" Width="16" Height="16" Stretch="None" Visibility="Collapsed"
                                      Data="M3.6,8.4 L6.9,11.7 L12.4,4.9"
                                      Stroke="{DynamicResource BrushAccentFG}" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Rectangle x:Name="Guion" Width="8" Height="2" RadiusX="1" RadiusY="1" Visibility="Collapsed"
                                           Fill="{DynamicResource BrushAccentFG}"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="Contenido" Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Contenido" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource BrushFG}"/>
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource BrushInputHoverBG}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Guion" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Caja" Property="Opacity" Value="0.88"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Caja" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox dentro de las celdas de una grilla (DataGridCheckBoxColumn.ElementStyle): centrado y sin alto minimo -->
    <Style x:Key="GridCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="MinHeight"           Value="0"/>
    </Style>

    <!-- Texto de las celdas de una grilla (DataGridTextColumn.ElementStyle): centrado verticalmente con el resto de la fila -->
    <Style x:Key="GridTexto" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
    </Style>

    <!-- Tarjeta con titulo: reemplaza al GroupBox de ModernWpf (titulo grande y sin marco) -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
        <Setter Property="Padding"    Value="12,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter ContentSource="Header" Margin="2,0,0,6" RecognizesAccessKey="True"
                                          TextElement.FontSize="13" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource BrushFG}"/>
                        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource BrushBorder}"
                                Background="{DynamicResource BrushPanelBG}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Listas: marco y fondo como los demas campos -->
    <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}">
        <Setter Property="Background"      Value="{DynamicResource BrushInputBG}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="2"/>
    </Style>

    <!-- Items de lista compactos (ModernWpf los hace de 40 px) -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding"   Value="8,2"/>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding"    Value="2,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Bd"
                                Grid.Row="0"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <!-- Expander: el trigger IsChecked rota la flecha dentro de su propio template -->
                                <ToggleButton x:Name="Expander"
                                              Grid.Column="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Width="16" Height="16">
                                                <Path x:Name="Arrow"
                                                      Data="M 2 0 L 8 6 L 2 12"
                                                      Stroke="{DynamicResource BrushFGMuted}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- La rotación vive DENTRO del template del ToggleButton,
                                                     así no hay referencias cruzadas entre templates -->
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 0 2 L 6 8 L 12 2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Row="1"
                                        Margin="16,0,0,0"
                                        Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushTreeHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushTreeSel}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushSelectedFG}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{DynamicResource BrushControlBG}"/>
        <Setter Property="Foreground"               Value="{DynamicResource BrushFG}"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="RowBackground"            Value="{DynamicResource BrushControlBG}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushAltRowBG}"/>
        <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushSplitter}"/>
        <Setter Property="VerticalGridLinesBrush"   Value="{DynamicResource BrushSplitter}"/>
        <Setter Property="RowHeight"                Value="26"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
        <Setter Property="Padding"         Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <!-- Plantilla propia: la de WPF ignora el Padding y el texto quedaba pegado al borde izquierdo -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"  Value="{DynamicResource BrushSelected}"/>
                <Setter Property="Foreground"  Value="{DynamicResource BrushSelectedFG}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"                 Value="{DynamicResource BrushHeaderBG}"/>
        <Setter Property="Foreground"                 Value="{DynamicResource BrushHeaderFG}"/>
        <Setter Property="FontWeight"                 Value="SemiBold"/>
        <Setter Property="BorderBrush"                Value="{DynamicResource BrushSplitter}"/>
        <Setter Property="BorderThickness"            Value="0,0,1,1"/>
        <Setter Property="Padding"                    Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource BrushAltRowBG}"/>
        <Setter Property="Width"      Value="0"/>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="MinWidth"  Value="0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding"   Value="8,0,0,0"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Raiz" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" Width="18" Height="18">
                            <Ellipse x:Name="Aro" StrokeThickness="1.2" Stroke="{DynamicResource BrushFGMuted}"
                                     Fill="{DynamicResource BrushInputBG}"/>
                            <Ellipse x:Name="Punto" Width="8" Height="8" Visibility="Collapsed"
                                     Fill="{DynamicResource BrushAccentFG}"/>
                        </Grid>
                        <ContentPresenter x:Name="Contenido" Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Contenido" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource BrushFG}"/>
                            <Setter TargetName="Aro" Property="Fill" Value="{DynamicResource BrushInputHoverBG}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Aro" Property="Fill" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Punto" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                            <Setter TargetName="Aro" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Label no hereda el Foreground de la ventana: se lo damos desde la paleta -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
        <Setter Property="Padding"    Value="0,2,4,2"/>
    </Style>
</ResourceDictionary>
