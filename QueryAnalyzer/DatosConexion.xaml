<Window x:Class="QueryAnalyzer.DatosConexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Configuración de Conexión"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>






        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Motor:" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbMotor" Grid.Row="1" Grid.Column="1" Margin="5"
                  DisplayMemberPath="Value" SelectedValuePath="Key"
                  SelectionChanged="cmbMotor_SelectionChanged"/>

        <CheckBox x:Name="chkUsarConnectionString"
                  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Usar connection string personalizado"
                  Margin="5,4"
                  Foreground="{DynamicResource BrushFG}"
                  Checked="chkUsarConnectionString_Changed"
                  Unchecked="chkUsarConnectionString_Changed"/>

        <TextBlock x:Name="lblConnectionString"
                   Grid.Row="3" Grid.Column="0"
                   Text="Connection String:" Margin="5,8,5,5" VerticalAlignment="Top"
                   Visibility="Collapsed"/>
        <TextBox x:Name="txtConnectionString"
                 Grid.Row="3" Grid.Column="1"
                 Margin="5" Height="70"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed"
                 ToolTip="Ingresá el connection string ODBC completo o una URI postgresql://user:pass@host:port/db"/>

        <TextBlock x:Name="lblServidor" Grid.Row="4" Grid.Column="0" Text="Servidor:" Margin="5" VerticalAlignment="Center"/>
        <Grid x:Name="pnlServidor" Grid.Row="4" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <!-- ComboBox editable: permite elegir un preset O escribir libremente -->
            <ComboBox x:Name="cmbServidor"
                      Grid.Column="0"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      VerticalAlignment="Center"
                      Margin="0,0,5,0"
                      ToolTip="Seleccioná un servidor predefinido del desplegable, o escribí uno nuevo directamente"
                      SelectionChanged="cmbServidor_SelectionChanged"/>
            <Button x:Name="btnBuscarBase" Grid.Column="1" Content="…" Width="25"
                    HorizontalAlignment="Right" IsEnabled="False" Click="btnBuscarBase_Click"/>
        </Grid>

        <TextBlock x:Name="lblPuerto" Grid.Row="5" Grid.Column="0" Text="Puerto:" Margin="5" VerticalAlignment="Center"/>
        <Grid x:Name="pnlPuerto" Grid.Row="5" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtPuerto" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <CheckBox x:Name="chkEsWeb" Grid.Column="1" Content="¿Es Web?" VerticalAlignment="Center"
                      Foreground="{DynamicResource BrushFG}"/>
        </Grid>

        <TextBlock x:Name="lblUsuario" Grid.Row="6" Grid.Column="0" Text="Usuario:" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtUsuario" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <TextBlock x:Name="lblContrasena" Grid.Row="7" Grid.Column="0" Text="Contraseña:" Margin="5" VerticalAlignment="Center"/>
        <Grid x:Name="pnlContrasena" Grid.Row="7" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="35"/>
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="txtContrasena" Grid.Column="0" LostFocus="txtContrasena_LostFocus"/>

            <TextBox x:Name="txtContrasenaRevelada" Grid.Column="0" Visibility="Collapsed" />

            <Button x:Name="btnTogglePass" Grid.Column="1" Margin="5,0,0,0"
                    Click="btnTogglePass_Click" FontSize="14" Padding="0">
                <Path Style="{StaticResource Ic}" Data="{StaticResource IconEye}"/>
            </Button>
        </Grid>

        <TextBlock x:Name="lblBaseDatos" Grid.Row="8" Grid.Column="0" Text="Base de datos:" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtBaseDatos" Grid.Row="8" Grid.Column="1" Margin="5"/>
        <ComboBox x:Name="cmbBaseDatos" Visibility="Hidden" Grid.Row="8" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5,6,0,2">
            <Button x:Name="btnCompartir" MinWidth="80"
                    Content="Compartir"
                    ToolTip="Copia los datos de esta conexión al portapapeles"
                    Click="btnCompartir_Click"/>
            <Button x:Name="btnImportar" MinWidth="80" Margin="8,0,0,0"
                    Content="Importar"
                    ToolTip="Carga el formulario con los datos de una conexión copiada con el botón Compartir (toma el texto del portapapeles)"
                    Click="btnImportar_Click"/>
        </StackPanel>
        <Button x:Name="btnProbar" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,6,5,2"
                Content="Probar Conexión" Width="112" Padding="2,2" HorizontalAlignment="Left"
                Click="btnProbar_Click"/>
        <Button x:Name="btnGuardar" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,6,5,2"
                Content="Guardar Conexión" Width="112" Padding="2,2" HorizontalAlignment="Right"
                Click="btnGuardar_Click"/>
    </Grid>
</Window>