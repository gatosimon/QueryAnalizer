<Window x:Class="QueryAnalyzer.LimpiadorTablaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar tabla"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Setter Property="Padding"    Value="0,2,4,2"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background"      Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="4,2"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background"  Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"  Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BrushBtnBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBtnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height"          Value="26"/>
                <Setter Property="Padding"         Value="8,0"/>
                <Setter Property="Cursor"          Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="lblTitulo" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

        <!-- Condiciones de baja -->
        <TextBlock Text="Condición de baja:" Margin="0,0,0,3"
                   FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
        <!-- Encabezado columnas -->
        <Grid Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Campo"      FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
            <TextBlock Grid.Column="1" Text="Operador"   FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
            <TextBlock Grid.Column="2" Text="Valor"      FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
            <TextBlock Grid.Column="3" Text="Val.cascada" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
        </Grid>
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,2">
            <StackPanel x:Name="spCondiciones"/>
        </ScrollViewer>
        <Button Content="➕ Agregar condición" HorizontalAlignment="Left"
                Height="24" Padding="6,0" Margin="0,0,0,8"
                Click="btnAgregarCond_Click"/>

        <!-- PK y opciones -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Campos PK:" VerticalAlignment="Center"/>
            <DockPanel Grid.Column="1">
                <ComboBox x:Name="cbPK" DockPanel.Dock="Left" Width="120"
                          ToolTip="Elegí una columna y presioná ➕ para agregarla a la PK"/>
                <Button x:Name="btnAgregarPK" DockPanel.Dock="Left" Content="➕" Width="26"
                        Margin="2,0,4,0" Click="btnAgregarPK_Click"
                        ToolTip="Agregar la columna seleccionada a la clave primaria"/>
                <TextBox x:Name="txtPK" VerticalContentAlignment="Center"
                         Background="{DynamicResource BrushControlBG}"
                         Foreground="{DynamicResource BrushFG}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         ToolTip="Columnas de la PK separadas por coma, en orden. Compuesta: 'Sucursal, Numero'"/>
            </DockPanel>
        </Grid>

        <CheckBox x:Name="chkReordenar" Content="Reordenar IDs" Margin="0,0,0,4"
                  ToolTip="Compactar los IDs de esta tabla eliminando huecos"/>
        <CheckBox x:Name="chkIncluir"   Content="Incluir en la operación" Margin="0,0,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Aceptar" Margin="0,0,6,0" IsDefault="True" Click="btnAceptar_Click"/>
            <Button Content="Cancelar" IsCancel="True" Click="btnCancelar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
