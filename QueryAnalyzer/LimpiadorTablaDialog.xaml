<Window x:Class="QueryAnalyzer.LimpiadorTablaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Configurar tabla"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="lblTitulo" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

        <!-- Condiciones de baja -->
        <TextBlock Text="Condición de baja:" Margin="0,0,0,3"
                   FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
        <!-- Encabezado columnas -->
        <Grid Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Campo"      FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
            <TextBlock Grid.Column="1" Text="Operador"   FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
            <TextBlock Grid.Column="2" Text="Valor"      FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
            <TextBlock Grid.Column="3" Text="Val.cascada" FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
        </Grid>
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,2">
            <StackPanel x:Name="spCondiciones"/>
        </ScrollViewer>
        <Button Content="Agregar condición" HorizontalAlignment="Left"
                Margin="0,6,0,12"
                Click="btnAgregarCond_Click"/>

        <!-- PK y opciones -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Campos PK:" VerticalAlignment="Center"/>
            <DockPanel Grid.Column="1">
                <ComboBox x:Name="cbPK" DockPanel.Dock="Left" Width="150"
                          ToolTip="Elegí una columna y presioná + para agregarla a la PK"/>
                <Button x:Name="btnAgregarPK" DockPanel.Dock="Left" Width="34" Padding="0"
                        Margin="6,0,8,0" Click="btnAgregarPK_Click"
                        ToolTip="Agregar la columna seleccionada a la clave primaria"><Path Style="{StaticResource Ic}" Data="{StaticResource IconPlus}"/></Button>
                <TextBox x:Name="txtPK" VerticalContentAlignment="Center"
                         ToolTip="Columnas de la PK separadas por coma, en orden. Compuesta: 'Sucursal, Numero'"/>
            </DockPanel>
        </Grid>

        <CheckBox x:Name="chkReordenar" Content="Reordenar IDs" Margin="0,0,0,2"
                  ToolTip="Compactar los IDs de esta tabla eliminando huecos"/>
        <CheckBox x:Name="chkIncluir"   Content="Incluir en la operación" Margin="0,0,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Aceptar" MinWidth="90" Margin="0,0,8,0" IsDefault="True" Click="btnAceptar_Click"/>
            <Button Content="Cancelar" MinWidth="90" IsCancel="True" Click="btnCancelar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
