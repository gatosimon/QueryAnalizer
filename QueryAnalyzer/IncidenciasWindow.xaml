<Window x:Class="QueryAnalyzer.IncidenciasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Incidencias"
        Width="1180" Height="640" MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}"/>

            <!-- El color de la severidad distingue lo que requiere decisión de lo informativo -->
            <Style x:Key="TextoSeveridad" TargetType="TextBlock" BasedOn="{StaticResource GridTexto}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SeveridadTexto}" Value="Crítica">
                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeveridadTexto}" Value="Error">
                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeveridadTexto}" Value="Aviso">
                        <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Textos largos: una línea con puntos suspensivos; el detalle completo va abajo -->
            <Style x:Key="TextoLargo" TargetType="TextBlock" BasedOn="{StaticResource GridTexto}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Resumen + filtro -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <TextBlock Text="Mostrar:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource BrushFGMuted}"/>
                <ComboBox x:Name="cmbFiltro" Width="160" SelectionChanged="cmbFiltro_SelectionChanged"/>
            </StackPanel>
            <TextBlock x:Name="txtResumen" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Grilla -->
        <DataGrid x:Name="dgIncidencias" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserAddRows="False"
                  SelectionChanged="dgIncidencias_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource GridTexto}" Header="Hora" Width="82" Binding="{Binding HoraTexto}"/>
                <DataGridTextColumn ElementStyle="{StaticResource TextoSeveridad}" Header="Severidad" Width="82" Binding="{Binding SeveridadTexto}"/>
                <DataGridTextColumn ElementStyle="{StaticResource GridTexto}" Header="Fase" Width="100" Binding="{Binding Fase}"/>
                <DataGridTextColumn ElementStyle="{StaticResource TextoLargo}" Header="Tabla" Width="1.3*" MinWidth="120" Binding="{Binding Tabla}"/>
                <DataGridTextColumn ElementStyle="{StaticResource TextoLargo}" Header="Columna" Width="*" MinWidth="90" Binding="{Binding Columna}"/>
                <DataGridTextColumn ElementStyle="{StaticResource TextoLargo}" Header="Fila / clave" Width="1.2*" MinWidth="110" Binding="{Binding Clave}"/>
                <DataGridTextColumn ElementStyle="{StaticResource TextoLargo}" Header="Tipo" Width="1.3*" MinWidth="130" Binding="{Binding Tipo}"/>
                <DataGridTextColumn ElementStyle="{StaticResource TextoLargo}" Header="Detalle" Width="2*" MinWidth="160" Binding="{Binding Mensaje}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detalle de la incidencia elegida -->
        <GroupBox Grid.Row="2" Header="Detalle y acción sugerida" Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="txtDetalle"
                         IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource BrushFG}"
                         FontSize="12"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Botones -->
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,10,0,0">
            <Button x:Name="btnExportar" DockPanel.Dock="Left" Content="Exportar CSV" MinWidth="120"
                    Click="btnExportar_Click" ToolTip="Guarda todas las incidencias en un archivo CSV (abre en Excel)"/>
            <Button x:Name="btnCopiar" DockPanel.Dock="Left" Content="Copiar" MinWidth="90" Margin="8,0,0,0"
                    Click="btnCopiar_Click" ToolTip="Copia las incidencias visibles como texto"/>
            <Button x:Name="btnCarpetaLogs" DockPanel.Dock="Left" Content="Abrir carpeta de logs" MinWidth="150" Margin="8,0,0,0"
                    Click="btnCarpetaLogs_Click"/>

            <Button x:Name="btnCerrar" DockPanel.Dock="Right" Content="Cerrar" MinWidth="110"
                    IsCancel="True" Click="btnCerrar_Click"/>
            <Button x:Name="btnContinuar" DockPanel.Dock="Right" Content="Continuar bajo mi responsabilidad"
                    MinWidth="230" Margin="0,0,8,0" Visibility="Collapsed"
                    Click="btnContinuar_Click"/>
        </DockPanel>
    </Grid>
</Window>
