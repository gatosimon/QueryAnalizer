<Window x:Class="QueryAnalyzer.LimpiadorBDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpiador de BD"
        Width="1100" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        Closed="Window_Closed">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Setter Property="Padding"    Value="0,2,4,2"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background"      Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="4,2"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background"      Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorder}"/>
                <Setter Property="Padding"         Value="4,2"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Background"            Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"            Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"           Value="{DynamicResource BrushBorder}"/>
                <Setter Property="RowBackground"         Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushAltRowBG}"/>
                <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="AutoGenerateColumns"   Value="False"/>
                <Setter Property="CanUserAddRows"        Value="False"/>
                <Setter Property="IsReadOnly"            Value="True"/>
                <Setter Property="SelectionMode"         Value="Single"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BrushBtnBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBtnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height"          Value="28"/>
                <Setter Property="Padding"         Value="10,0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="GroupBox">
                <Setter Property="Foreground"    Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"   Value="{DynamicResource BrushBorder}"/>
                <Setter Property="Padding"       Value="6"/>
                <Setter Property="Margin"        Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Contenido principal -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ PANEL IZQUIERDO ═══════════════ -->
            <DockPanel Grid.Column="0" Margin="8,8,0,8">

                <!-- Config global -->
                <GroupBox DockPanel.Dock="Top" Header="Configuración global">
                    <StackPanel>
                        <!-- Fila: conflictos + reordenar -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Conflictos FK:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbModoConflicto" Grid.Column="1"
                                      SelectionChanged="cbModoConflicto_SelectionChanged"
                                      ToolTip="Qué hacer cuando hay hijos activos que referencian a padres dados de baja. 'Borrado en cascada' los elimina físicamente en vez de marcarlos, y alcanza tablas que no tildaste.">
                                <ComboBoxItem Content="Bloquear" Tag="Bloquear"/>
                                <ComboBoxItem Content="Baja en cascada" Tag="BajaEnCascada"/>
                                <ComboBoxItem Content="Ignorar (omitir conflictivos)" Tag="Ignorar"/>
                                <ComboBoxItem Content="Borrado en cascada (sin bajas lógicas)" Tag="BorradoEnCascada"/>
                                <ComboBoxItem Tag="BorradoSeguro"
                                              Content="Borrado seguro (respeta las FK, no arrastra)"
                                              ToolTip="Borra físicamente una fila dada de baja SÓLO si ninguna fila viva la referencia. No alcanza tablas que no tildaste. Las filas en baja que todavía tengan hijos vivos quedan sin borrar: eso es lo esperado, no un error."/>
                                <ComboBoxItem Tag="BorradoIterativo"
                                              Content="Borrado iterativo (⚠ arrastra filas activas)"
                                              ToolTip="Suspende las FK, borra TODAS las bajas lógicas sin mirar quién las referencia, y después barre en loop las filas que quedaron sin conectar con nada, hasta que no quede ninguna. ATENCIÓN: borra filas ACTIVAS — una fila viva que sólo apuntaba a registros dados de baja queda apuntando a la nada y se elimina. Una fila que sigue enganchada por algún otro dato sobrevive. Al terminar te muestra qué FK quedaron violadas, antes de que confirmes."/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="chkDepurarHuerfanos"
                                  Content="Depurar relaciones truncadas" Margin="0,0,0,2"
                                  ToolTip="Elimina las filas cuya FK apunta a un padre que ya no existe, y arrastra a las que queden huérfanas por ese borrado, hasta cerrar la cadena. Las tablas sin relaciones (catálogos) no se tocan."/>
                        <CheckBox x:Name="chkCentinelas" IsChecked="True" Margin="16,0,0,6"
                                  IsEnabled="{Binding IsChecked, ElementName=chkDepurarHuerfanos}"
                                  Content="Tratar 0 y '' como 'sin referencia'"
                                  ToolTip="Las bases derivadas de Magic usan 0 o cadena vacía en vez de NULL cuando no hay referencia. Destildado, una FK en 0 cuenta como referencia rota y la fila se borra."/>

                        <CheckBox x:Name="chkReordenarGlobal"
                                  Content="Reordenar IDs (compactar huecos)" Margin="0,0,0,6"
                                  ToolTip="Renumerar los IDs para eliminar los huecos dejados por los registros eliminados. Si la PK es IDENTITY, la tabla se rehace con SET IDENTITY_INSERT."/>

                        <!-- El ToolTip lo pone cbModoConflicto_SelectionChanged: cambia según el modo,
                             y el modo iterativo además lo deshabilita. -->
                        <CheckBox x:Name="chkFrenoSeguridad"
                                  Content="Frenar si una tabla pierde más del 90% de sus filas" Margin="0,0,0,6"/>

                        <!-- Constructor de condiciones de baja global -->
                        <TextBlock Text="Condición de baja global:" Margin="0,0,0,3"
                                   FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
                        <!-- Encabezado de columnas -->
                        <Grid Margin="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Campo" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                            <TextBlock Grid.Column="1" Text="Operador" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                            <TextBlock Grid.Column="2" Text="Valor" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                            <TextBlock Grid.Column="3" Text="Val.cascada" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                        </Grid>
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="spCondicionesGlobal"/>
                        </ScrollViewer>
                        <Button Content="➕ Agregar condición" HorizontalAlignment="Left"
                                Margin="0,4,0,4" Height="24" Padding="8,0"
                                Click="btnAgregarCondGlobal_Click"
                                ToolTip="Agregar una condición de baja al grupo global"/>
                        <DockPanel Margin="0,0,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Unir con:" VerticalAlignment="Center"
                                       FontSize="10" Margin="0,0,4,0"
                                       Foreground="{DynamicResource BrushFGMuted}"/>
                            <ComboBox x:Name="cbCombinadorDetectar" DockPanel.Dock="Left" Width="60"
                                      Margin="0,0,6,0" SelectedIndex="0"
                                      Background="{DynamicResource BrushControlBG}"
                                      Foreground="{DynamicResource BrushFG}"
                                      BorderBrush="{DynamicResource BrushBorder}"
                                      ToolTip="Cómo se unen entre sí las condiciones detectadas cuando la tabla tiene más de un campo de baja (ej: BajaUsuario y BajaFecha)">
                                <ComboBoxItem Content="AND"/>
                                <ComboBoxItem Content="OR"/>
                            </ComboBox>
                            <Button x:Name="btnDetectar"
                                    Content="🔍 Detectar campos automáticamente" HorizontalAlignment="Stretch"
                                    Click="btnDetectar_Click"
                                    ToolTip="Detecta BajaUsuario, BajaFecha, IsDeleted, Activo y la clave primaria de cada tabla"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Filtro por esquema -->
                <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <Label Content="Esquema:" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbEsquema" DockPanel.Dock="Left"
                              ToolTip="Define el alcance de TODA la operación: detección, aplicación de condiciones, análisis y script sólo tocan el esquema elegido"
                              SelectionChanged="cbEsquema_SelectionChanged"/>
                </DockPanel>
                <TextBlock x:Name="txtAlcance" DockPanel.Dock="Top" Margin="0,2,0,2"
                           FontSize="10" Foreground="{DynamicResource BrushFGMuted}"
                           Text="Alcance: (Todos) — 0 tabla(s), 0 incluida(s)"/>

                <!-- Botones de tabla -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,2">
                    <Button Content="☑ Todas" Margin="0,0,4,0" Width="75" Click="btnSelTodas_Click"/>
                    <Button Content="☐ Ninguna" Margin="0,0,4,0" Width="75" Click="btnSelNinguna_Click"/>
                    <Button Content="⚙ Aplicar a seleccionadas" Margin="0,0,0,0" Click="btnAplicarSeleccionadas_Click"
                            ToolTip="Aplica el campo/valor de baja global a las tablas seleccionadas en la lista"/>
                </StackPanel>

                <!-- Lista de tablas -->
                <ListView x:Name="lvTablas" SelectionMode="Extended"
                          Background="{DynamicResource BrushControlBG}"
                          Foreground="{DynamicResource BrushFG}"
                          BorderBrush="{DynamicResource BrushBorder}"
                          MouseDoubleClick="lvTablas_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="28">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Incluir, Mode=TwoWay}"
                                                  Checked="chkIncluir_Changed" Unchecked="chkIncluir_Changed"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Tabla"    Width="120" DisplayMemberBinding="{Binding NombreCompleto}"/>
                            <GridViewColumn Header="Condición" Width="160" DisplayMemberBinding="{Binding ResumenCondiciones}"/>
                            <GridViewColumn Header="PK"       Width="110" DisplayMemberBinding="{Binding ResumenPK}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BrushSplitter}"/>

            <!-- ═══════════════ PANEL DERECHO ═══════════════ -->
            <DockPanel Grid.Column="2" Margin="0,8,8,8">
                <TabControl x:Name="tabResultado" DockPanel.Dock="Top" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=DockPanel}}">

                    <!-- Tab Análisis -->
                    <TabItem x:Name="tabAnalisis" Header="Análisis">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgAnalisis" Grid.Row="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tabla" Binding="{Binding NombreCompleto}" Width="180"/>
                                    <DataGridTextColumn Header="En baja" Binding="{Binding RegistrosBaja}" Width="70"/>
                                    <DataGridTextColumn Header="Activos" Binding="{Binding RegistrosActivos}" Width="70"/>
                                    <DataGridTextColumn Header="Cascada (≥)" Binding="{Binding CascadaEstimada}" Width="80"/>
                                    <DataGridTextColumn Header="Retenidas" Binding="{Binding RetenidasPorExterno}" Width="70"/>
                                    <DataGridTextColumn Header="Huérfanos" Binding="{Binding Huerfanos}" Width="75"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="140"/>
                                    <DataGridTextColumn Header="Detalle" Binding="{Binding ConflictosTexto}" Width="*"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="Conflicto">
                                                <Setter Property="Foreground" Value="#E05050"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Cascada">
                                                <Setter Property="Foreground" Value="#C8A020"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Cascada (fuera de selección)">
                                                <Setter Property="Foreground" Value="#C8A020"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Se omite">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <Border Grid.Row="1" Background="{DynamicResource BrushPanelBG}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                                    Padding="6,4" MinHeight="40">
                                <TextBlock x:Name="txtAdvertencias" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab Relaciones truncadas -->
                    <TabItem x:Name="tabTruncadas" Header="Relaciones truncadas">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgTruncadas" Grid.Row="0" IsReadOnly="True"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tabla hija"  Binding="{Binding TablaHija}"  Width="170"/>
                                    <DataGridTextColumn Header="Columnas"    Binding="{Binding Columnas}"   Width="160"/>
                                    <DataGridTextColumn Header="Tabla padre" Binding="{Binding TablaPadre}" Width="170"/>
                                    <DataGridTextColumn Header="Filas rotas" Binding="{Binding FilasRotas}" Width="80"/>
                                    <DataGridTextColumn Header="Valores huérfanos" Binding="{Binding Ejemplos}" Width="150"/>
                                    <DataGridTextColumn Header="Alcance"     Binding="{Binding Alcance}"    Width="*"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FueraDeAlcance}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <Border Grid.Row="1" Background="{DynamicResource BrushPanelBG}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                                    Padding="6,4" MinHeight="40">
                                <TextBlock x:Name="txtSinTruncadas" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushFGMuted}" FontSize="11"
                                           Text="Sin relaciones truncadas. Tildá 'Depurar relaciones truncadas' en la configuración global y volvé a analizar para que este informe se llene."/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="tabRetenciones" Header="Retenciones">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgRetenciones" Grid.Row="0" IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      MouseDoubleClick="dgRetenciones_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No se puede borrar de" Binding="{Binding TablaRetenida}"   Width="170"/>
                                    <DataGridTextColumn Header="Filas"                 Binding="{Binding FilasRetenidas}"  Width="60"/>
                                    <DataGridTextColumn Header="La retiene"            Binding="{Binding TablaQueRetiene}" Width="170"/>
                                    <DataGridTextColumn Header="Columnas"              Binding="{Binding Columnas}"        Width="150"/>
                                    <DataGridTextColumn Header="Motivo"                Binding="{Binding Motivo}"          Width="120"/>
                                    <DataGridTextColumn Header="Qué hacer"             Binding="{Binding QueHacer}"        Width="*"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                                        <!-- Los mensajes ODBC no entran en la columna: van completos acá. -->
                                        <Setter Property="ToolTip" Value="{Binding QueHacer}"/>
                                        <Style.Triggers>
                                            <!-- Sólo lo accionable va destacado; el resto pide una decisión. -->
                                            <DataTrigger Binding="{Binding EsAccionable}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <Border Grid.Row="1" Background="{DynamicResource BrushPanelBG}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                                    Padding="6,4" MinHeight="40">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <!-- ShowOnDisabled: sin esto WPF oculta el tooltip justo cuando
                                             el botón está apagado, que es cuando hace falta explicar. -->
                                        <Button x:Name="btnIncluirRetenedoras" Content="✚ Incluir las tablas que retienen"
                                                Click="btnIncluirRetenedoras_Click" Padding="8,3" Margin="0,0,6,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Tilda las tablas de las filas 'Cadena incompleta' y les detecta los campos de baja. Cada tabla sigue borrando sólo sus propias bajas: no se arrastra nada. Después volvé a analizar."/>
                                        <Button x:Name="btnVerQueRetiene" Content="🔍 Ver qué la retiene"
                                                Click="btnVerQueRetiene_Click" Padding="8,3"
                                                ToolTip="Abre en la pestaña 'Script SQL' la consulta que devuelve las filas que están reteniendo, para poder mirarlas antes de decidir."/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtSinRetenciones" TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushFGMuted}" FontSize="11"
                                               Text="Este informe se llena con el modo 'Borrado seguro'. Muestra qué filas dadas de baja NO se van a borrar y por qué: 'Cadena incompleta' se resuelve incluyendo la tabla que retiene; 'Datos vivos' es una decisión de negocio."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab Script -->
                    <TabItem x:Name="tabScript" Header="Script SQL">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
                                <Button Content="📋 Copiar al portapapeles" Margin="0,0,6,0"
                                        Click="btnCopiar_Click"/>
                                <TextBlock x:Name="txtMensajeCopia" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
                            </StackPanel>

                            <TextBox x:Name="txtScript" Grid.Row="1"
                                     FontFamily="Consolas,Courier New" FontSize="12"
                                     AcceptsReturn="True" IsReadOnly="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     Background="{DynamicResource BrushEditor}"
                                     Foreground="{DynamicResource BrushEditorFG}"
                                     BorderBrush="{DynamicResource BrushBorder}"/>
                        </Grid>
                    </TabItem>

                    <!-- Tab Progreso -->
                    <TabItem x:Name="tabProgreso" Header="Ejecución" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ProgressBar x:Name="pbar" Grid.Row="0" Height="16" Margin="0,0,0,6"
                                         Background="{DynamicResource BrushControlBG}"
                                         Foreground="{DynamicResource BrushAccent}"/>
                            <TextBox x:Name="txtLog" Grid.Row="1"
                                     FontFamily="Consolas,Courier New" FontSize="11"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource BrushControlBG}"
                                     Foreground="{DynamicResource BrushFG}"
                                     BorderBrush="{DynamicResource BrushBorder}"/>
                            <TextBlock x:Name="txtEstadoEjecucion" Grid.Row="2" Margin="0,4,0,0"
                                       Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <!-- ═══════════════ BARRA INFERIOR ═══════════════ -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                Background="{DynamicResource BrushPanelBG}" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="btnAnalizar" Content="🔎 Analizar" Margin="0,0,6,0"
                            ToolTip="Ejecutar análisis de los registros en baja (sin modificar datos)"
                            Click="btnAnalizar_Click"/>
                    <Button x:Name="btnGenerarScript" Content="📄 Generar Script" Margin="0,0,6,0" IsEnabled="False"
                            ToolTip="Generar el script SQL para revisar antes de ejecutar"
                            Click="btnGenerarScript_Click"/>
                    <Button x:Name="btnEjecutar" Content="▶ Ejecutar Script" Margin="0,0,6,0" IsEnabled="False"
                            ToolTip="Ejecutar el script en una transacción (se pedirá confirmación antes del COMMIT)"
                            Click="btnEjecutar_Click"/>
                </StackPanel>
                <Button Content="Cerrar" HorizontalAlignment="Right" DockPanel.Dock="Right"
                        Click="btnCerrar_Click"/>
                <TextBlock x:Name="txtEstadoBarra" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
