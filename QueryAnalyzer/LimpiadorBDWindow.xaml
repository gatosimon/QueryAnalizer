<Window x:Class="QueryAnalyzer.LimpiadorBDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpiador de BD"
        Width="1100" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        Closed="Window_Closed">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Setter Property="Padding"    Value="0,2,4,2"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background"      Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="4,2"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background"      Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBorder}"/>
                <Setter Property="Padding"         Value="4,2"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Background"            Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground"            Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"           Value="{DynamicResource BrushBorder}"/>
                <Setter Property="RowBackground"         Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushAltRowBG}"/>
                <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="AutoGenerateColumns"   Value="False"/>
                <Setter Property="CanUserAddRows"        Value="False"/>
                <Setter Property="IsReadOnly"            Value="True"/>
                <Setter Property="SelectionMode"         Value="Single"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BrushBtnBG}"/>
                <Setter Property="Foreground"      Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushBtnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height"          Value="28"/>
                <Setter Property="Padding"         Value="10,0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="GroupBox">
                <Setter Property="Foreground"    Value="{DynamicResource BrushFG}"/>
                <Setter Property="BorderBrush"   Value="{DynamicResource BrushBorder}"/>
                <Setter Property="Padding"       Value="6"/>
                <Setter Property="Margin"        Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Contenido principal -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ PANEL IZQUIERDO ═══════════════ -->
            <DockPanel Grid.Column="0" Margin="8,8,0,8">

                <!-- Config global -->
                <GroupBox DockPanel.Dock="Top" Header="Configuración global">
                    <StackPanel>
                        <!-- Fila: conflictos + reordenar -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Conflictos FK:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbModoConflicto" Grid.Column="1"
                                      ToolTip="Qué hacer cuando hay hijos activos que referencian a padres dados de baja">
                                <ComboBoxItem Content="Bloquear" Tag="Bloquear"/>
                                <ComboBoxItem Content="Baja en cascada" Tag="BajaEnCascada"/>
                                <ComboBoxItem Content="Ignorar (omitir conflictivos)" Tag="Ignorar"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="chkReordenarGlobal"
                                  Content="Reordenar IDs (compactar huecos)" Margin="0,0,0,6"
                                  ToolTip="Renumerar los IDs para eliminar los huecos dejados por los registros eliminados"/>

                        <!-- Constructor de condiciones de baja global -->
                        <TextBlock Text="Condición de baja global:" Margin="0,0,0,3"
                                   FontSize="11" Foreground="{DynamicResource BrushFGMuted}"/>
                        <!-- Encabezado de columnas -->
                        <Grid Margin="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Campo" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                            <TextBlock Grid.Column="1" Text="Operador" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                            <TextBlock Grid.Column="2" Text="Valor" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                            <TextBlock Grid.Column="3" Text="Val.cascada" FontSize="10" Foreground="{DynamicResource BrushFGMuted}"/>
                        </Grid>
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="spCondicionesGlobal"/>
                        </ScrollViewer>
                        <Button Content="➕ Agregar condición" HorizontalAlignment="Left"
                                Margin="0,4,0,4" Height="24" Padding="8,0"
                                Click="btnAgregarCondGlobal_Click"
                                ToolTip="Agregar una condición de baja al grupo global"/>
                        <Button Content="🔍 Detectar campos automáticamente" HorizontalAlignment="Stretch"
                                Margin="0,0,0,0" Click="btnDetectar_Click"
                                ToolTip="Detecta BajaUsuario, BajaFecha, IsDeleted, Activo y configura condiciones automáticamente"/>
                    </StackPanel>
                </GroupBox>

                <!-- Filtro por esquema -->
                <DockPanel DockPanel.Dock="Top" Margin="0,6,0,2">
                    <Label Content="Esquema:" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbEsquema" DockPanel.Dock="Left"
                              ToolTip="Filtrar la lista de tablas por esquema (solo afecta la vista)"
                              SelectionChanged="cbEsquema_SelectionChanged"/>
                </DockPanel>

                <!-- Botones de tabla -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,2">
                    <Button Content="☑ Todas" Margin="0,0,4,0" Width="75" Click="btnSelTodas_Click"/>
                    <Button Content="☐ Ninguna" Margin="0,0,4,0" Width="75" Click="btnSelNinguna_Click"/>
                    <Button Content="⚙ Aplicar a seleccionadas" Margin="0,0,0,0" Click="btnAplicarSeleccionadas_Click"
                            ToolTip="Aplica el campo/valor de baja global a las tablas seleccionadas en la lista"/>
                </StackPanel>

                <!-- Lista de tablas -->
                <ListView x:Name="lvTablas" SelectionMode="Extended"
                          Background="{DynamicResource BrushControlBG}"
                          Foreground="{DynamicResource BrushFG}"
                          BorderBrush="{DynamicResource BrushBorder}"
                          MouseDoubleClick="lvTablas_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="28">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Incluir, Mode=TwoWay}"
                                                  Checked="chkIncluir_Changed" Unchecked="chkIncluir_Changed"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Tabla"    Width="120" DisplayMemberBinding="{Binding NombreCompleto}"/>
                            <GridViewColumn Header="Condición" Width="160" DisplayMemberBinding="{Binding ResumenCondiciones}"/>
                            <GridViewColumn Header="PK"       Width="55"  DisplayMemberBinding="{Binding CampoPK}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BrushSplitter}"/>

            <!-- ═══════════════ PANEL DERECHO ═══════════════ -->
            <DockPanel Grid.Column="2" Margin="0,8,8,8">
                <TabControl x:Name="tabResultado" DockPanel.Dock="Top" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=DockPanel}}">

                    <!-- Tab Análisis -->
                    <TabItem Header="Análisis">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgAnalisis" Grid.Row="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tabla" Binding="{Binding NombreCompleto}" Width="180"/>
                                    <DataGridTextColumn Header="En baja" Binding="{Binding RegistrosBaja}" Width="70"/>
                                    <DataGridTextColumn Header="Activos" Binding="{Binding RegistrosActivos}" Width="70"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                                    <DataGridTextColumn Header="Detalle conflictos" Binding="{Binding ConflictosTexto}" Width="*"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="Conflicto">
                                                <Setter Property="Foreground" Value="#E05050"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Cascada">
                                                <Setter Property="Foreground" Value="#C8A020"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Se omite">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <Border Grid.Row="1" Background="{DynamicResource BrushPanelBG}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                                    Padding="6,4" MinHeight="40">
                                <TextBlock x:Name="txtAdvertencias" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab Script -->
                    <TabItem Header="Script SQL">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
                                <Button Content="📋 Copiar al portapapeles" Margin="0,0,6,0"
                                        Click="btnCopiar_Click"/>
                                <TextBlock x:Name="txtMensajeCopia" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
                            </StackPanel>

                            <TextBox x:Name="txtScript" Grid.Row="1"
                                     FontFamily="Consolas,Courier New" FontSize="12"
                                     AcceptsReturn="True" IsReadOnly="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     Background="{DynamicResource BrushEditor}"
                                     Foreground="{DynamicResource BrushEditorFG}"
                                     BorderBrush="{DynamicResource BrushBorder}"/>
                        </Grid>
                    </TabItem>

                    <!-- Tab Progreso -->
                    <TabItem x:Name="tabProgreso" Header="Ejecución" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ProgressBar x:Name="pbar" Grid.Row="0" Height="16" Margin="0,0,0,6"
                                         Background="{DynamicResource BrushControlBG}"
                                         Foreground="{DynamicResource BrushAccent}"/>
                            <TextBox x:Name="txtLog" Grid.Row="1"
                                     FontFamily="Consolas,Courier New" FontSize="11"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource BrushControlBG}"
                                     Foreground="{DynamicResource BrushFG}"
                                     BorderBrush="{DynamicResource BrushBorder}"/>
                            <TextBlock x:Name="txtEstadoEjecucion" Grid.Row="2" Margin="0,4,0,0"
                                       Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <!-- ═══════════════ BARRA INFERIOR ═══════════════ -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                Background="{DynamicResource BrushPanelBG}" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="btnAnalizar" Content="🔎 Analizar" Margin="0,0,6,0"
                            ToolTip="Ejecutar análisis de los registros en baja (sin modificar datos)"
                            Click="btnAnalizar_Click"/>
                    <Button x:Name="btnGenerarScript" Content="📄 Generar Script" Margin="0,0,6,0" IsEnabled="False"
                            ToolTip="Generar el script SQL para revisar antes de ejecutar"
                            Click="btnGenerarScript_Click"/>
                    <Button x:Name="btnEjecutar" Content="▶ Ejecutar Script" Margin="0,0,6,0" IsEnabled="False"
                            ToolTip="Ejecutar el script en una transacción (se pedirá confirmación antes del COMMIT)"
                            Click="btnEjecutar_Click"/>
                </StackPanel>
                <Button Content="Cerrar" HorizontalAlignment="Right" DockPanel.Dock="Right"
                        Click="btnCerrar_Click"/>
                <TextBlock x:Name="txtEstadoBarra" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource BrushFGMuted}" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
