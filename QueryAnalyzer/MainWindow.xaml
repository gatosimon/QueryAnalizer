<Window x:Class="QueryAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Query Analyzer (ODBC)" Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        Icon="/Assets/Logo.ico"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] Tema inicial: claro. El code-behind reemplaza este slot al cambiar de tema. -->
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <!-- [1] Estilos compartidos del rediseño (IconButton, RailButton, BottomTab, ...) -->
                <ResourceDictionary Source="Styles.xaml"/>
                <!-- [2] Estilos de controles compartidos (Button, TextBox, ComboBox, DataGrid, TreeView...) -->
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Filas de resultados de queries -->
            <Style x:Key="ResultGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="{DynamicResource BrushControlBG}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource BrushAltRowBG}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushSelected}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushSelectedFG}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Filas de las listas del panel lateral (Historial / Mis consultas) -->
            <Style x:Key="ItemListaLateral" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Setter Property="Padding"    Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    BorderBrush="{DynamicResource BrushSplitter}" BorderThickness="0,0,0,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSelected}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushSelectedFG}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="grdRaiz">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- barra de comandos -->
            <RowDefinition Height="*"/>      <!-- cuerpo -->
            <RowDefinition Height="Auto"/>   <!-- barra de estado -->
        </Grid.RowDefinitions>

        <!-- ══ Barra de comandos ═════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BrushWindowBG}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">

                <!-- Derecha (de afuera hacia adentro) -->
                <TextBlock x:Name="txtVersion"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource BrushFGMuted}"
                           ToolTip="Versión de la aplicación"/>

                <Button x:Name="btnAyuda" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        ToolTip="Ayuda" Click="BtnAyuda_Click">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconHelp}"/>
                </Button>

                <!-- Preferencias y drivers ODBC -->
                <Button x:Name="btnConfig" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0,0,2,0"
                        ToolTip="Preferencias y drivers ODBC" Click="BtnConfig_Click">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconSliders}"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Preferencias"  Click="BtnPreferencias_Click"/>
                            <MenuItem Header="Drivers ODBC"  Click="BtnDriversOdbc_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Alternar claro / oscuro: el code-behind muestra el icono que corresponde -->
                <Button x:Name="btnToggleTema" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0,0,2,0"
                        ToolTip="Alternar modo claro / oscuro" Click="BtnToggleTema_Click">
                    <Grid>
                        <Path x:Name="icoTemaLuna" Style="{StaticResource Ic}" Data="{StaticResource IconMoon}"/>
                        <Path x:Name="icoTemaSol"  Style="{StaticResource Ic}" Data="{StaticResource IconSun}" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Rectangle DockPanel.Dock="Right" Width="1" Height="20" Margin="8,0"
                           Fill="{DynamicResource BrushBorder}"/>

                <!-- Menu de herramientas -->
                <Button x:Name="btnHerramientas" DockPanel.Dock="Right" VerticalAlignment="Center"
                        ToolTip="Comparar, transferir y limpiar bases de datos" Click="BtnHerramientas_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconTools}"/>
                        <TextBlock Text="Herramientas" Margin="8,0,6,0" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconChevronDown}" Width="12" Height="12"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="btnComparador" Header="Comparar BDs" Click="btnComparador_Click"
                                      ToolTip="Comparar estructura y datos entre dos bases de datos">
                                <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconCompare}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="btnPasadorDatos" Header="Transferir datos" Click="btnPasadorDatos_Click"
                                      ToolTip="Transferir datos entre bases: genera scripts INSERT con resolución de FK">
                                <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconTransfer}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="btnLimpiadorBD" Header="Limpiar BD" Click="btnLimpiadorBD_Click"
                                      ToolTip="Eliminar registros dados de baja lógica y reordenar IDs manteniendo integridad referencial">
                                <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconBroom}"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Izquierda: conexión -->
                <Path DockPanel.Dock="Left" Style="{StaticResource Ic}" Data="{StaticResource IconDb}"
                      Margin="0,0,10,0" Stroke="{DynamicResource BrushAccent}"/>
                <ComboBox x:Name="cbDriver" Width="130" IsEditable="True" VerticalAlignment="Center"
                          DockPanel.Dock="Left" Margin="0,0,6,0"
                          ui:ControlHelper.PlaceholderText="Driver"
                          ToolTip="Driver / proveedor"
                          SelectionChanged="cbdriver_SelectionChanged"/>
                <ComboBox x:Name="cbConnectionName" Width="280" IsEditable="True" VerticalAlignment="Center"
                          DockPanel.Dock="Left" Margin="0,0,6,0"
                          ui:ControlHelper.PlaceholderText="Conexión"
                          ToolTip="Conexión"
                          SelectionChanged="cbConnectionName_SelectionChanged"/>
                <Button x:Name="btnTest" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        ToolTip="Probar conexión" Click="BtnTest_Click">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconPlug}"/>
                </Button>
                <Button x:Name="btnNewConn" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        ToolTip="Nueva conexión" Click="BtnNewConn_Click">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconPlus}"/>
                </Button>
                <Button x:Name="btnEditConn" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        ToolTip="Editar conexión" Click="BtnEditConn_Click">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconEdit}"/>
                </Button>
                <Button x:Name="btnDeleteConn_Copy" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        ToolTip="Eliminar conexión" Click="btnDeleteConn_Click">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconTrash}"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- ══ Cuerpo: riel | panel lateral | área principal ═════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition x:Name="colLateral" Width="300" MinWidth="230"/>
                <ColumnDefinition x:Name="colSplitLateral" Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Riel de vistas -->
            <Border Grid.Column="0" Background="{DynamicResource BrushWindowBG}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,6,0,0">
                    <ToggleButton x:Name="tbRielExplorador" Style="{StaticResource RailButton}" IsChecked="True"
                                  ToolTip="Explorador de tablas y vistas" Click="Riel_Click">
                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconDb}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="tbRielConsultas" Style="{StaticResource RailButton}"
                                  ToolTip="Mis consultas guardadas" Click="Riel_Click">
                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconList}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="tbRielHistorial" Style="{StaticResource RailButton}"
                                  ToolTip="Historial de consultas" Click="Riel_Click">
                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconHistory}"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Panel lateral con tres vistas -->
            <Border x:Name="panelLateral" Grid.Column="1" ClipToBounds="True" Background="{DynamicResource BrushPanelBG}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid>

                    <!-- ── Vista: Explorador ─────────────────────────────── -->
                    <Grid x:Name="vistaExplorador">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- título -->
                            <RowDefinition Height="Auto"/>   <!-- buscador -->
                            <RowDefinition Height="Auto"/>   <!-- Todas / Tablas / Vistas -->
                            <RowDefinition Height="Auto"/>   <!-- esquema -->
                            <RowDefinition Height="Auto"/>   <!-- Seleccionar / Acciones -->
                            <RowDefinition Height="Auto"/>   <!-- contadores -->
                            <RowDefinition Height="*"/>      <!-- árbol -->
                            <RowDefinition Height="Auto"/>   <!-- islas -->
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="12,8,6,6">
                            <Button x:Name="btnColapsarLateral" DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Ocultar el panel (Ctrl+B)" Click="BtnColapsarLateral_Click">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconChevronLeft}"/>
                            </Button>
                            <Button x:Name="btnExplorar" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    ToolTip="Explorar: leer las tablas y vistas de la base conectada"
                                    Click="btnExplorar_Click">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconRefresh}"/>
                            </Button>
                            <TextBlock Text="EXPLORADOR" Style="{StaticResource SectionHeader}"/>
                        </DockPanel>

                        <!-- Buscador -->
                        <Grid Grid.Row="1" Margin="12,0,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtBuscar" Grid.Column="0"
                                     ui:ControlHelper.PlaceholderText="Buscar tabla o columna…"
                                     KeyDown="txtBuscar_KeyDown"
                                     VerticalContentAlignment="Center"/>
                            <Button x:Name="btnBuscar" Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                    ToolTip="Buscar" Click="btnBuscar_Click">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconSearch}"/>
                            </Button>
                        </Grid>

                        <!-- Filtro por tipo (selector segmentado). cbTipoObjeto conserva la lógica y queda oculto. -->
                        <Border Grid.Row="2" Margin="12,0,12,8" CornerRadius="8" Padding="1"
                                Background="{DynamicResource BrushAltRowBG}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="rbTipoTodas"  Style="{StaticResource SegRadio}" Content="Todas"  Tag="0" IsChecked="True" Checked="TipoSeg_Checked"/>
                                <RadioButton x:Name="rbTipoTablas" Style="{StaticResource SegRadio}" Content="Tablas" Tag="1" Checked="TipoSeg_Checked"/>
                                <RadioButton x:Name="rbTipoVistas" Style="{StaticResource SegRadio}" Content="Vistas" Tag="2" Checked="TipoSeg_Checked"/>
                            </UniformGrid>
                        </Border>
                        <ComboBox x:Name="cbTipoObjeto" Grid.Row="2" Visibility="Collapsed" SelectedIndex="0"
                                  SelectionChanged="cbTipoObjeto_SelectionChanged">
                            <ComboBoxItem Content="Ambas" Tag="BOTH"   IsSelected="True"/>
                            <ComboBoxItem Content="Tablas" Tag="TABLE"/>
                            <ComboBoxItem Content="Vistas" Tag="VIEW"/>
                        </ComboBox>

                        <!-- Esquema (se puebla desde code-behind) -->
                        <Grid Grid.Row="3" Margin="12,0,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Esquema" Style="{StaticResource SectionHeader}" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cbSchema" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"
                                      SelectionChanged="cbSchema_SelectionChanged"
                                      ToolTip="Filtrar por esquema">
                                <ComboBoxItem Content="(todos)" Tag=""/>
                            </ComboBox>
                        </Grid>

                        <!-- Menús de selección y de acciones sobre varias tablas -->
                        <Grid Grid.Row="4" Margin="12,0,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSeleccionarMenu" Grid.Column="0" HorizontalAlignment="Stretch"
                                    ToolTip="Seleccionar tablas o vistas" Click="BtnSeleccionar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Seleccionar" VerticalAlignment="Center"/>
                                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="btnSelTodos" Header="Todos los visibles" Click="btnSelTodos_Click"
                                                  ToolTip="Seleccionar todas las tablas/vistas visibles"/>
                                        <MenuItem x:Name="btnDeselTodos" Header="Ninguno" Click="btnDeselTodos_Click"
                                                  ToolTip="Deseleccionar todo"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="btnAccionesMenu" Grid.Column="2" HorizontalAlignment="Stretch"
                                    ToolTip="Acciones sobre las tablas seleccionadas o visibles" Click="BtnAcciones_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Acciones" VerticalAlignment="Center"/>
                                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="btnGenerarJoin" Header="Generar JOIN…" IsEnabled="False" Click="btnGenerarJoin_Click"
                                                  ToolTip="Generar SELECT JOIN o CREATE VIEW con las tablas/vistas seleccionadas (mínimo 2)">
                                            <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconLink}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="btnGenerarInserts" Header="Backup de esquema" IsEnabled="False" Click="btnGenerarInserts_Click"
                                                  ToolTip="Generar script .sql de resguardo de las tablas seleccionadas — restaurable contra la misma base (orden FK, IDENTITY y transacción incluidos)">
                                            <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconSave}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="btnRestaurarBackup" Header="Restaurar backup…" Click="btnRestaurarBackup_Click"
                                                  ToolTip="Ejecutar un script .sql de backup generado por QueryAnalyzer contra la conexión activa (respeta las fases FK y usa una transacción con rollback)">
                                            <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconRestore}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="btnDocumentar" Header="Documentar (.docx)" Click="btnDocumentar_Click"
                                                  ToolTip="Generar archivo .docx con la estructura de las tablas/vistas visibles">
                                            <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconTable}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="btnEsquematizar" Header="Esquematizar (Draw.io)" Click="btnEsquematizar_Click"
                                                  ToolTip="Generar diagrama de relaciones en Draw.io con las tablas/vistas visibles">
                                            <MenuItem.Icon><Path Style="{StaticResource Ic}" Data="{StaticResource IconDesign}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="btnExplorarConsultas" Header="Explorar consultas" Click="btnExplorarConsultas_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <DockPanel Grid.Row="5" Margin="14,0,14,4">
                            <TextBlock x:Name="txtSeleccionContador" DockPanel.Dock="Right" FontSize="11"
                                       Foreground="{DynamicResource BrushFGMuted}" Text="0 sel."/>
                            <TextBlock x:Name="txtExplorar" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource BrushFGMuted}" Text="Tablas exploradas"/>
                        </DockPanel>

                        <!-- Árbol: tvSearch (resultado de búsqueda profunda) y tvSchema se alternan -->
                        <Grid Grid.Row="6" Margin="6,0">
                            <TreeView x:Name="tvSearch" Visibility="Collapsed" MouseDoubleClick="tvSchema_MouseDoubleClick"/>
                            <TreeView x:Name="tvSchema" Visibility="Visible"   MouseDoubleClick="tvSchema_MouseDoubleClick"/>
                        </Grid>

                        <!-- Islas de tablas -->
                        <Border Grid.Row="7" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <ToggleButton x:Name="tbIslas" Style="{StaticResource GhostToggle}" Click="BtnIslas_Click" HorizontalAlignment="Stretch"
                                              ToolTip="Conjuntos de tablas guardados para filtrar el explorador">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="icoIslas" Style="{StaticResource Ic}" Data="{StaticResource IconChevronRight}" Width="12" Height="12"/>
                                        <TextBlock Text="Islas de tablas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel x:Name="panelIslas" Visibility="Collapsed" Margin="12,0,12,10">
                                    <ComboBox x:Name="cbIslas" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                              SelectionChanged="cbIslas_SelectionChanged"
                                              ToolTip="Seleccionar una isla para filtrar el explorador"/>
                                    <UniformGrid Rows="1">
                                        <Button x:Name="btnGuardarIsla" HorizontalAlignment="Stretch" Margin="0,0,3,0"
                                                Click="btnGuardarIsla_Click"
                                                ToolTip="Guardar las tablas marcadas con checkbox como una nueva isla">
                                            <Path Style="{StaticResource Ic}" Data="{StaticResource IconPlus}"/>
                                        </Button>
                                        <Button x:Name="btnLimpiarIsla" HorizontalAlignment="Stretch" Margin="3,0"
                                                Click="btnLimpiarIsla_Click"
                                                ToolTip="Mostrar todas las tablas/vistas (quitar filtro de isla)">
                                            <Path Style="{StaticResource Ic}" Data="{StaticResource IconClose}"/>
                                        </Button>
                                        <Button x:Name="btnEliminarIsla" HorizontalAlignment="Stretch" Margin="3,0,0,0"
                                                Click="btnEliminarIsla_Click"
                                                ToolTip="Eliminar la isla seleccionada">
                                            <Path Style="{StaticResource Ic}" Data="{StaticResource IconTrash}"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Vista: Mis consultas ──────────────────────────── -->
                    <Grid x:Name="vistaConsultas" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="12,8,6,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Ocultar el panel (Ctrl+B)" Click="BtnColapsarLateral_Click">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconChevronLeft}"/>
                            </Button>
                            <TextBlock Text="MIS CONSULTAS" Style="{StaticResource SectionHeader}"/>
                        </DockPanel>
                        <ListBox x:Name="lstMisConsultas" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="lstMisConsultas_SelectionChanged"
                                 MouseDoubleClick="lstMisConsultas_MouseDoubleClick"
                                 KeyDown="lstMisConsultas_KeyDown"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ItemListaLateral}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Cargar en editor" Click="menuMC_Cargar_Click"/>
                                    <MenuItem Header="Editar" Click="menuMC_Editar_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Eliminar" Click="menuMC_Eliminar_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Background="Transparent">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Descripcion}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Opacity="0.55">
                                            <Run Text="{Binding Usuario}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Fecha, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ── Vista: Historial ─────────────────────────────── -->
                    <Grid x:Name="vistaHistorial" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="12,8,6,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Ocultar el panel (Ctrl+B)" Click="BtnColapsarLateral_Click">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconChevronLeft}"/>
                            </Button>
                            <TextBlock Text="HISTORIAL" Style="{StaticResource SectionHeader}"/>
                        </DockPanel>
                        <ListBox x:Name="lstHistory" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="LstHistory_SelectionChanged"
                                 KeyDown="lstHistory_KeyDown"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ItemListaLateral}"/>
                    </Grid>

                </Grid>
            </Border>

            <GridSplitter x:Name="splitLateral" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" MouseDoubleClick="splitLateral_DoubleClick" ToolTip="Arrastrar para cambiar el ancho; doble clic para ocultar el panel"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

            <!-- ══ Área principal: editor + panel inferior ═════════════════ -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>               <!-- pestañas de consulta -->
                    <RowDefinition Height="Auto"/>               <!-- barra del editor -->
                    <RowDefinition Height="2*" MinHeight="90"/>  <!-- editor -->
                    <RowDefinition Height="5"/>                  <!-- splitter -->
                    <RowDefinition Height="3*" MinHeight="120"/> <!-- panel inferior -->
                </Grid.RowDefinitions>

                <!-- Pestañas de consulta: cada una tiene su texto, sus parámetros y sus resultados -->
                <Border Grid.Row="0" Background="{DynamicResource BrushWindowBG}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,0,8,0" Height="37">
                    <DockPanel LastChildFill="False">
                        <TabControl x:Name="tcConsultas" DockPanel.Dock="Left" Style="{StaticResource QueryTabControl}"
                                    VerticalAlignment="Bottom" SelectionChanged="tcConsultas_SelectionChanged"/>
                        <Button x:Name="btnNuevaPestana" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                Margin="4,0,0,2" VerticalAlignment="Bottom"
                                ToolTip="Nueva consulta (Ctrl+T)" Click="btnNuevaPestana_Click">
                            <Path Style="{StaticResource Ic}" Data="{StaticResource IconPlus}"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Barra del editor: Ejecutar es la acción principal -->
                <Border Grid.Row="1" Background="{DynamicResource BrushPanelBG}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnExecute" Style="{StaticResource AccentCompositeButton}" Padding="14,2"
                                ToolTip="Ejecutar la consulta (F5)" Click="BtnExecute_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IcFill}" Data="{StaticResource IconPlay}" Width="14" Height="14"/>
                                <TextBlock Text="Ejecutar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="F5" Margin="8,0,0,0" Opacity="0.75" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnExecuteScalar" Margin="6,0,0,0" Content="Ejecutar escalar" Click="BtnExecuteScalar_Click"
                                ToolTip="Ejecutar y devolver un único valor"/>

                        <!-- Cancelar: activo solo mientras hay una query en curso -->
                        <Button x:Name="btnCancelarQuery" Style="{StaticResource CompositeButton}" Margin="6,0,0,0" IsEnabled="False" Click="BtnCancelarQuery_Click"
                                ToolTip="Cancelar la consulta en curso">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IcFill}" Data="{StaticResource IconStop}" Width="14" Height="14"/>
                                <TextBlock Text="Cancelar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Indicador de progreso: solo visible mientras ejecuta -->
                        <ProgressBar x:Name="progEjecucion" IsIndeterminate="True" Width="110" Height="4"
                                     Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="lblEjecutando" Text="Ejecutando…" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontStyle="Italic"
                                   Foreground="{DynamicResource BrushAccent}" Visibility="Collapsed"/>

                        <Rectangle Width="1" Height="20" Margin="12,0" Fill="{DynamicResource BrushBorder}"/>

                        <Button x:Name="btnGuardarConsulta" Style="{StaticResource GhostButton}" Click="btnGuardarConsulta_Click"
                                ToolTip="Guardar el contenido actual del editor como consulta con título y descripción">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconSave}"/>
                                <TextBlock Text="Guardar consulta" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnLimpiarConsulta" Style="{StaticResource GhostButton}" Click="btnLimpiarConsulta_Click"
                                ToolTip="Borrar el contenido del área de consulta">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconClose}"/>
                                <TextBlock Text="Limpiar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <avalon:TextEditor x:Name="txtQuery"
                                   Grid.Row="2"
                                   Margin="0"
                                   Padding="4,4,0,0"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   SyntaxHighlighting="SQL"
                                   WordWrap="False"
                                   Background="{DynamicResource BrushEditor}"
                                   Foreground="{DynamicResource BrushEditorFG}"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   KeyUp="txtQuery_KeyUp"/>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

                <!-- Panel inferior: Resultados | Parámetros | Mensajes -->
                <TabControl x:Name="tcPanelInferior" Grid.Row="4" Style="{StaticResource BottomTabControl}"
                            SelectionChanged="tcPanelInferior_SelectionChanged">

                    <TabItem Style="{StaticResource BottomTab}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconTable}"/>
                                <TextBlock Text="Resultados" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Border x:Name="badgeResultados" Style="{StaticResource Contador}">
                                    <TextBlock x:Name="txtBadgeResultados" Text="0" FontSize="10.5" FontWeight="Normal"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource BrushFGMuted}"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Resumen y acciones sobre los resultados -->
                            <DockPanel Grid.Row="0" Margin="10,6,10,2" LastChildFill="False">
                                <Button x:Name="btnExcel" Style="{StaticResource CompositeButton}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BtnExcel_Click"
                                        ToolTip="Exportar los resultados o generar scripts">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconDownload}"/>
                                        <TextBlock Text="Generar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnClear" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="BtnClear_Click"
                                        ToolTip="Cerrar todos los resultados">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconClose}"/>
                                        <TextBlock Text="Limpiar resultados" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                                            TextElement.Foreground="{DynamicResource BrushFGMuted}">
                                    <TextBlock x:Name="txtColumnCount" Text="0"/>
                                    <TextBlock Text=" columnas  ·  "/>
                                    <TextBlock x:Name="txtRowCount" Text="0"/>
                                    <TextBlock Text=" filas  ·  "/>
                                    <TextBlock x:Name="txtTiempoDeEjecucion" Text="0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Etiquetas de los resultados + grillas (se arman en code-behind) -->
                            <TabControl x:Name="tcResults" Grid.Row="1" Grid.RowSpan="2" Margin="0,4,0,0"
                                        Style="{StaticResource ChipTabControl}"
                                        SelectionChanged="tcResults_SelectionChanged"/>

                            <!-- Barra de guardado: visible solo cuando hay celdas editadas sin guardar -->
                            <Border x:Name="barGuardarCambios" Grid.Row="3"
                                    Background="{DynamicResource BrushPanelBG}"
                                    BorderBrush="{DynamicResource BrushAccent}"
                                    BorderThickness="0,1,0,0"
                                    Padding="10,6"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushWarning}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="lblCambiosPendientes"
                                               Text="Hay cambios sin guardar"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushWarning}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0"/>
                                    <Button x:Name="btnGuardarCambios" Style="{StaticResource AccentCompositeButton}" Click="BtnGuardarCambios_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Ic}" Data="{StaticResource IconSave}"/>
                                            <TextBlock Text="Guardar cambios" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnDescartarCambios" Style="{StaticResource CompositeButton}" Margin="6,0,0,0" Click="BtnDescartarCambios_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Ic}" Data="{StaticResource IconUndo}"/>
                                            <TextBlock Text="Descartar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="(doble clic en una celda para editar)"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushFGMuted}"
                                               FontSize="11"
                                               Margin="14,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource BottomTab}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconParam}"/>
                                <TextBlock Text="Parámetros" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Border x:Name="badgeParametros" Style="{StaticResource Contador}">
                                    <TextBlock x:Name="txtBadgeParametros" Text="0" FontSize="10.5" FontWeight="Normal"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource BrushFGMuted}"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="12,8,12,6" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource BrushFGMuted}"
                                   Text="Cada ? que escribas en la consulta (por ejemplo: WHERE Id = ?) agrega una fila acá, en el mismo orden. Completá el valor de cada una antes de ejecutar."/>
                        <DataGrid x:Name="gridParams" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NOMBRE"
                                                    Binding="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                                <DataGridComboBoxColumn Header="TIPO"
                                                        SelectedValueBinding="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}"
                                                        DisplayMemberPath="Key"
                                                        SelectedValuePath="Value"
                                                        Width="160">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.OdbcTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.OdbcTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="VALOR"
                                                    Binding="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource BottomTab}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ic}" Data="{StaticResource IconMessage}"/>
                                <TextBlock Text="Mensajes" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Border x:Name="badgeMensajes" Style="{StaticResource Contador}">
                                    <TextBlock x:Name="txtBadgeMensajes" Text="0" FontSize="10.5" FontWeight="Normal"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource BrushFGMuted}"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="10,6,10,2" LastChildFill="False">
                                <Button x:Name="btnLimpiarLog" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="BtnLimpiarLog_Click"
                                        ToolTip="Borrar los mensajes">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconClose}"/>
                                        <TextBlock Text="Limpiar mensajes" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <TextBox x:Name="txtMessages" Grid.Row="1"
                                     IsReadOnly="True" BorderThickness="0"
                                     Background="{DynamicResource BrushControlBG}"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ══ Barra de estado ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource BrushPanelBG}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,0" Height="26">
            <DockPanel LastChildFill="False" TextElement.FontSize="11">
                <TextBlock x:Name="txtModoTema" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource BrushFGMuted}" Text="Modo claro"/>
                <TextBlock x:Name="txtPosicionCursor" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource BrushFGMuted}" Text="Ln 1, Col 1"/>

                <Ellipse x:Name="elpEstadoConexion" DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{DynamicResource BrushFGMuted}"/>
                <TextBlock x:Name="txtEstadoConexion" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                           FontWeight="SemiBold" Text="Sin conexión"/>
                <TextBlock x:Name="txtEstadoDetalle" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource BrushFGMuted}"/>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource BrushFGMuted}">
                    <Run Text="{Binding Text, ElementName=txtRowCount, Mode=OneWay}"/><Run Text=" filas"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource BrushFGMuted}"
                           Text="{Binding Text, ElementName=txtTiempoDeEjecucion, Mode=OneWay}"/>
            </DockPanel>
        </Border>

        <!-- ══ Aviso mientras se cambia de modo claro / oscuro ═══════════════ -->
        <Grid x:Name="overlayTema" Grid.RowSpan="3" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource BrushWindowBG}" Opacity="0.78"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,16"
                    Background="{DynamicResource BrushPanelBG}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Path Width="22" Height="22" Stretch="Uniform" Data="M8,1.5 A6.5,6.5 0 1 1 1.5,8"
                          Stroke="{DynamicResource BrushAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <RotateTransform/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock x:Name="txtOverlayTema" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource BrushFG}" Text="Cambiando de modo…"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
