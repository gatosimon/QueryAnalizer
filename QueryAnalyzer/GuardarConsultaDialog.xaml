<Window x:Class="QueryAnalyzer.GuardarConsultaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Guardar consulta"
        Height="440" Width="560"
        MinHeight="340" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Título *" FontWeight="SemiBold"/>
        <TextBox   Grid.Row="2" x:Name="txtTitulo" MaxLength="120"
                   ToolTip="Nombre corto para identificar la consulta (obligatorio)"/>

        <!-- Descripción -->
        <TextBlock Grid.Row="4" Text="Descripción" FontWeight="SemiBold"/>
        <TextBox   Grid.Row="6" x:Name="txtDescripcion"
                   Height="70" TextWrapping="Wrap"
                   AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                   ToolTip="Detalle opcional: para qué sirve, qué devuelve, etc."/>

        <!-- Usuario -->
        <Grid Grid.Row="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Usuario" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="2" x:Name="txtUsuario" MaxLength="80"
                       ToolTip="Nombre del autor (se pre-completa con el usuario de Windows)"/>

            <!-- Vista previa de la consulta -->
            <TextBlock Grid.Row="4" Text="Vista previa de la consulta" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="6"
                       x:Name="txtPreview"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       FontFamily="Consolas"
                       FontSize="11"
                       Background="{DynamicResource BrushPanelBG}"
                       Opacity="0.85"/>
        </Grid>

        <!-- Botones -->
        <StackPanel Grid.Row="10" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btnGuardar" Content="Guardar"
                    IsDefault="True"
                    Click="btnGuardar_Click"/>
            <Button Content="Cancelar"
                    IsCancel="True"
                    Margin="8,0,0,0"
                    Click="btnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
