    <!-- Iconos vectoriales sobre una grilla de 16x16. Se tiñen con el Foreground del control que los contiene,
         asi respetan el tema claro/oscuro, el hover y el estado deshabilitado.
         Uso:  <Path Style="{StaticResource Ic}" Data="{StaticResource IconPlay}"/> -->

    <Style x:Key="Ic" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
    </Style>

    <!-- Variante rellena (play, stop) -->
    <Style x:Key="IcFill" TargetType="Path" BasedOn="{StaticResource Ic}">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
    </Style>

