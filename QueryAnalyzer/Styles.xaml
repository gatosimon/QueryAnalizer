<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019">

    <!-- Estilos compartidos del rediseño. Se mezclan en App.xaml. Los colores salen de la paleta
         de la ventana (ThemeLight/ThemeDark) via DynamicResource, asi cambian con el tema. -->

    <!-- Boton de icono cuadrado, sin borde -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- ModernWpf solo atenua el contenido de texto simple; con un icono adentro hay que atenuar el boton -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Boton secundario sin relieve (icono + texto) -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Boton normal y boton de acento con contenido compuesto (icono + texto) -->
    <Style x:Key="CompositeButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AccentCompositeButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Titulo de seccion de un panel -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Boton del riel lateral (ToggleButton) -->
    <Style x:Key="RailButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Fondo" Margin="4,2" CornerRadius="6" Background="Transparent"/>
                        <Border x:Name="Marca" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource BrushAccent}" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selector segmentado (RadioButton) -->
    <Style x:Key="SegRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" CornerRadius="5" Margin="1" Padding="0,4" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushControlBG}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pestana del panel inferior: subrayado de acento cuando esta activa -->
    <Style x:Key="BottomTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Fondo" Background="Transparent" Padding="12,0" Height="34"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BottomTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBG}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BrushPanelBG}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="6,0">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pestanas de consulta (arriba del editor): linea de acento arriba cuando esta activa -->
    <Style x:Key="QueryTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Raiz" Margin="0,3,1,0">
                        <Border x:Name="Fondo" Background="Transparent" Height="33" Padding="12,0,6,0"
                                CornerRadius="6,6,0,0" BorderThickness="1,1,1,0" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="Linea" Height="2" VerticalAlignment="Top" CornerRadius="6,6,0,0"
                                Background="{DynamicResource BrushAccent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Raiz" Property="Margin" Value="0,3,1,-1"/>
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushPanelBG}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                            <Setter TargetName="Linea" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Solo la tira de encabezados: el contenido (editor) es unico y se intercambia por codigo -->
    <Style x:Key="QueryTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource QueryTab}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etiquetas tipo "chip" para elegir entre varios resultados -->
    <Style x:Key="ChipTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Fondo" CornerRadius="13" Padding="11,3" Background="Transparent"
                            BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushSelected}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushSelectedFG}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChipTab}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Padding="10,0,10,6">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Encabezado plegable de una seccion (ToggleButton sin relieve, alineado a la izquierda) -->
    <Style x:Key="GhostToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Fondo" Background="Transparent" Padding="14,9">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Numero pequeño dentro de una pestana (cantidad de resultados / mensajes / parametros) -->
    <Style x:Key="Contador" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Background" Value="{DynamicResource BrushAltRowBG}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

</ResourceDictionary>
