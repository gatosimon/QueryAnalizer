<Window x:Class="QueryAnalyzer.DialogoMensajeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Mensaje"
        Width="460" MinWidth="360" MaxHeight="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,22,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icono del tipo de mensaje: el color lo asigna el code-behind -->
            <Viewbox x:Name="vbIcono" Grid.Column="0" Width="30" Height="30" VerticalAlignment="Top" Margin="0,2,16,0">
                <Path x:Name="icono" Style="{StaticResource Ic}" Data="{StaticResource IconInfo}"/>
            </Viewbox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                <TextBlock x:Name="txtMensaje" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                           VerticalAlignment="Center" Margin="0,4,6,0"/>
            </ScrollViewer>
        </Grid>

        <!-- Franja inferior de botones -->
        <Border Grid.Row="1" Background="{DynamicResource BrushPanelBG}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel x:Name="panelBotones" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
