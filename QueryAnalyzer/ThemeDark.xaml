<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── PALETA OSCURA ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushWindowBG"   Color="#202020"/>
    <SolidColorBrush x:Key="BrushPanelBG"    Color="#2B2B2B"/>
    <SolidColorBrush x:Key="BrushControlBG"  Color="#2D2D2D"/>
    <SolidColorBrush x:Key="BrushAltRowBG"   Color="#343434"/>
    <SolidColorBrush x:Key="BrushBorder"     Color="#454545"/>
    <SolidColorBrush x:Key="BrushSplitter"   Color="#383838"/>
    <SolidColorBrush x:Key="BrushFG"         Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BrushFGMuted"    Color="#A6A6A6"/>
    <SolidColorBrush x:Key="BrushHover"      Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BrushSelected"   Color="#264F78"/>
    <SolidColorBrush x:Key="BrushSelectedFG" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccent"     Color="#4CC2FF"/>
    <SolidColorBrush x:Key="BrushHeaderBG"   Color="#343434"/>
    <SolidColorBrush x:Key="BrushHeaderFG"   Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BrushBtnBG"      Color="#333333"/>
    <SolidColorBrush x:Key="BrushBtnBorder"  Color="#4A4A4A"/>
    <SolidColorBrush x:Key="BrushTreeHover"  Color="#333333"/>
    <SolidColorBrush x:Key="BrushTreeSel"    Color="#264F78"/>
    <SolidColorBrush x:Key="BrushTabSelBG"   Color="#2B2B2B"/>
    <SolidColorBrush x:Key="BrushTabSelBdr"  Color="#4CC2FF"/>
    <SolidColorBrush x:Key="BrushTabSelFG"   Color="#4CC2FF"/>
    <SolidColorBrush x:Key="BrushMenuBG"     Color="#2B2B2B"/>
    <SolidColorBrush x:Key="BrushMenuHover"  Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BrushSeparator"  Color="#454545"/>
    <SolidColorBrush x:Key="BrushEditor"     Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BrushEditorFG"   Color="#D4D4D4"/>
    <SolidColorBrush x:Key="BrushRowHover"   Color="#2F3E4D"/>
    <SolidColorBrush x:Key="BrushNroFilaBG"  Color="#333333"/>
    <SolidColorBrush x:Key="BrushNroFilaFG"  Color="#A6A6A6"/>
    <SolidColorBrush x:Key="BrushDanger"     Color="#FF99A4"/>
    <SolidColorBrush x:Key="BrushSuccess"    Color="#6CCB5F"/>
    <SolidColorBrush x:Key="BrushWarning"    Color="#FCE100"/>
    <SolidColorBrush x:Key="BrushAccentFG"   Color="#00263D"/>
    <SolidColorBrush x:Key="BrushDangerBG"   Color="#442726"/>
    <SolidColorBrush x:Key="BrushSuccessBG"  Color="#1F3A1F"/>
    <SolidColorBrush x:Key="BrushWarningBG"  Color="#433519"/>
    <SolidColorBrush x:Key="BrushInputBG"      Color="#383838"/>
    <SolidColorBrush x:Key="BrushInputHoverBG" Color="#404040"/>
    <SolidColorBrush x:Key="BrushInputFocusBG" Color="#303030"/>
    <SolidColorBrush x:Key="BrushControlBorder"      Color="#3E3E3E"/>
    <SolidColorBrush x:Key="BrushControlBorderHover" Color="#505050"/>

    <!-- Version de la paleta. Debe coincidir con PreferenciasWindow.VersionTemas:
         si el archivo en %AppData%\QueryAnalyzer\Themes tiene una menor, se reemplaza (con backup .bak). -->
    <x:String x:Key="ThemeVersion">5</x:String>

</ResourceDictionary>
