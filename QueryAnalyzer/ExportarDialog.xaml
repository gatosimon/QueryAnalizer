<Window x:Class="QueryAnalyzer.ExportarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Generar resultados"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">

        <!-- Título sección formato -->
        <TextBlock Text="Formato de exportación"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Margin="0,0,0,10"/>

        <!-- Excel -->
        <Border Background="{DynamicResource BrushControlBG}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="6"
                Margin="0,0,0,6" Padding="10,8">
            <RadioButton x:Name="rbExcel" IsChecked="True" GroupName="Formato" Checked="rbArchivo_Checked">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconTable}" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Excel (.xlsx)"    FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Una hoja por resultado, con formato y colores"
                                   FontSize="10" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </Border>

        <!-- CSV -->
        <Border Background="{DynamicResource BrushControlBG}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="6"
                Margin="0,0,0,6" Padding="10,8">
            <RadioButton x:Name="rbCsv" GroupName="Formato" Checked="rbArchivo_Checked">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconList}" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="CSV (.csv)"      FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Separado por punto y coma, compatible con Excel"
                                   FontSize="10" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </Border>

        <!-- JSON -->
        <Border Background="{DynamicResource BrushControlBG}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="6"
                Margin="0,0,0,6" Padding="10,8">
            <RadioButton x:Name="rbJson" GroupName="Formato" Checked="rbJson_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{}{ }" FontSize="16" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="JSON (.json)"     FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Array de objetos, una entrada por fila del resultado activo"
                                   FontSize="10" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </Border>

        <!-- SQL INSERT -->
        <Border Background="{DynamicResource BrushControlBG}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="6"
                Margin="0,0,0,6" Padding="10,8">
            <RadioButton x:Name="rbSql" GroupName="Formato" Checked="rbSql_Checked">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconDb}" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="SQL Script (INSERT)"  FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Una línea INSERT por fila del resultado activo"
                                   FontSize="10" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </Border>

        <!-- Opciones SQL (visible solo cuando rbSql está seleccionado) -->
        <Border x:Name="pnlOpcionesSql"
                Visibility="Collapsed"
                Background="{DynamicResource BrushControlBG}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="6"
                Margin="0,0,0,6" Padding="10,10">
            <StackPanel>
                <TextBlock Text="Nombre de la tabla destino:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNombreTabla" FontFamily="Consolas" Padding="4,3" Margin="0,0,0,10"/>
                <CheckBox x:Name="chkDeletePrevio"
                          Content="Incluir DELETE FROM antes de los INSERTs"
                          IsChecked="False"/>
            </StackPanel>
        </Border>

        <!-- Opciones de archivo (visible solo para Excel/CSV) -->
        <TextBlock x:Name="lblOpcionesArchivo"
                   Text="Opciones"
                   FontWeight="SemiBold" FontSize="13"
                   Margin="0,0,0,8"/>

        <CheckBox x:Name="chkEncabezados"
                  Content="Incluir fila de encabezados (nombres de columna)"
                  IsChecked="True"
                  Margin="0,0,0,16"/>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Generar"
                    IsDefault="True"
                    Click="btnGenerar_Click"/>
            <Button Content="Cancelar"
                    IsCancel="True"
                    Margin="8,0,0,0"
                    Click="btnCancelar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
