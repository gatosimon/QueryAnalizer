<Window x:Class="QueryAnalyzer.TableDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Design"
        Width="820" Height="520"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        Loaded="Window_Loaded"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tema inicial claro; el code-behind aplica el tema activo de MainWindow en Loaded. -->
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- La grilla, las celdas, los encabezados y el CheckBox salen de Controles.xaml, igual que en el resto de la app.
                 Acá solo van los colores de estado de las filas. -->

            <!-- Fila marcada para eliminar → rojo semántico; fila nueva → verde semántico.
                 Los colores salen de la paleta del tema (BrushDanger / BrushSuccess y sus fondos suaves). -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MarcarParaEliminar}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushDangerBG}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding EsNueva}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushSuccessBG}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Celda Column Name en negrita si es PK -->
            <Style x:Key="CeldaNombreStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding EsPK}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CeldaTextoStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushFG}"/>
            </Style>

            <Style x:Key="CeldaDefaultStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushFGMuted}"/>
                <Setter Property="FontStyle"  Value="Italic"/>
            </Style>

            <!-- ComboBox de tipos de dato (editable, temático) -->
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Barra de acciones ── -->
        <Border Grid.Row="0" Background="{DynamicResource BrushPanelBG}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAgregar" Click="AgregarColumna_Click" ToolTip="Agregar nueva columna">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Ic}" Data="{StaticResource IconPlus}"/>
                        <TextBlock Text="Nueva columna" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnScript" Click="GenerarScript_Click" Margin="6,0,0,0" Content="Aplicar"
                        ToolTip="Generar script DDL con los cambios detectados"/>
                <Button x:Name="btnRecargar" Click="Recargar_Click" Margin="6,0,0,0" Content="Recargar"
                        ToolTip="Recargar desde la base de datos (descarta cambios)"/>

                <Rectangle Width="1" Height="20" Margin="14,0" Fill="{DynamicResource BrushBorder}"/>

                <!-- ── Renombrar tabla ── -->
                <TextBlock Text="Renombrar tabla:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource BrushFGMuted}"/>
                <TextBox x:Name="txtNuevoNombre" Width="200" VerticalContentAlignment="Center"
                         ToolTip="Nuevo nombre para la tabla. Dejá vacío para no renombrar."/>
                <Button x:Name="btnRenombrar" Click="RenombrarTabla_Click" IsEnabled="False" Margin="6,0,0,0"
                        Content="Renombrar" ToolTip="Agregar sentencia RENAME al script"/>
            </StackPanel>
        </Border>

        <!-- ── Panel: Descripción de tabla + Modo de aplicación ── -->
        <Border Grid.Row="1"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BrushBorder}"
                Background="{DynamicResource BrushPanelBG}"
                Padding="12,10,12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 0: Descripción de la tabla -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Descripción:" VerticalAlignment="Center"
                           Margin="0,0,10,8"
                           Foreground="{DynamicResource BrushFGMuted}"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                           x:Name="txtDescripcionTabla"
                           Margin="0,0,0,8" MaxLength="500"
                           ToolTip="Descripción de la tabla (MS_Description / COMMENT ON TABLE)"/>

                <!-- Fila 1: Modo de aplicación -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Al aplicar:" VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource BrushFGMuted}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="rbRevisarScript"
                                 Content="Generar script para revisión"
                                 IsChecked="False" GroupName="ModoAplicar"
                                 VerticalAlignment="Center"
                                 ToolTip="El script se cargará en el editor para que lo revises y ejecutes manualmente."/>
                    <RadioButton x:Name="rbAplicarDirecto"
                                 Content="Aplicar directamente"
                                 GroupName="ModoAplicar"
                                 IsChecked="True"
                                 VerticalAlignment="Center" Margin="28,0,0,0"
                                 ToolTip="Los cambios se aplicarán automáticamente contra la base de datos al cerrar."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── DataGrid principal ── -->
        <DataGrid Grid.Row="2" x:Name="dgColumnas"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  IsReadOnly="False">

            <!-- Header de fila: ícono de llave si es PK -->
            <DataGrid.RowHeaderTemplate>
                <DataTemplate>
                    <Path Style="{StaticResource Ic}" Data="{StaticResource IconKey}" Stroke="{DynamicResource BrushWarning}" ToolTip="Clave primaria"
                               Visibility="{Binding DataContext.EsPK,
                                            RelativeSource={RelativeSource AncestorType=DataGridRow},
                                            Converter={StaticResource BoolToVis}}"/>
                </DataTemplate>
            </DataGrid.RowHeaderTemplate>

            <DataGrid.Columns>

                <!-- Column Name -->
                <DataGridTextColumn Header="Column Name" Width="*"
                                    Binding="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource CeldaNombreStyle}"/>

                <!-- Data Type: ComboBox editable con los tipos del motor activo.
                     ItemsSource se lee desde Tag del DataGrid (asignado en code-behind). -->
                <DataGridTemplateColumn Header="Data Type" Width="200">

                    <!-- Vista normal (celda no editando) -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TipoDatoCompleto}"
                                       Style="{StaticResource CeldaTextoStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <!-- Vista en edición: ComboBox editable -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding TipoDatoCompleto,
                                             UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding Tag,
                                             RelativeSource={RelativeSource
                                             AncestorType=DataGrid}}"
                                      BorderThickness="0"
                                      Padding="2,0"
                                      VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>

                </DataGridTemplateColumn>

                <!-- Allow Nulls -->
                <DataGridCheckBoxColumn Header="Allow Nulls" Width="100"
                                        Binding="{Binding EsNulable, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridCheckBoxColumn.ElementStyle><Style TargetType="CheckBox" BasedOn="{StaticResource GridCheckBox}"/></DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle><Style TargetType="CheckBox" BasedOn="{StaticResource GridCheckBox}"/></DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>

                <!-- Default Value -->
                <DataGridTextColumn Header="Default Value" Width="140"
                                    Binding="{Binding ValorDefault, UpdateSourceTrigger=LostFocus}"
                                    ElementStyle="{StaticResource CeldaDefaultStyle}"/>

                <!-- Descripción -->
                <DataGridTextColumn Header="Descripción" Width="220"
                                    Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}"
                                    ElementStyle="{StaticResource CeldaDefaultStyle}"/>

            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Marcar para eliminar" Click="EliminarColumna_Click"/>
                    <MenuItem Header="Desmarcar eliminación"  Click="DesmarcarEliminar_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- ── Barra de estado ── -->
        <Border Grid.Row="3" Background="{DynamicResource BrushPanelBG}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,0" Height="26">
            <DockPanel LastChildFill="False" TextElement.FontSize="11">
                <TextBlock x:Name="txtMotor" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushFGMuted}"/>
                <TextBlock x:Name="txtEstado" DockPanel.Dock="Left" VerticalAlignment="Center" Text="Listo"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
