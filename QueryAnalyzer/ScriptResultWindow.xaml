<Window x:Class="QueryAnalyzer.ScriptResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Script generado"
        Width="700" Height="460"
        MinWidth="400" MinHeight="250"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBG}"
        Foreground="{DynamicResource BrushFG}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tema inicial claro; el code-behind aplica el tema activo de MainWindow en el constructor. -->
                <ResourceDictionary Source="ThemeLight.xaml"/>
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="txtScript"
                 IsReadOnly="False"
                 FontFamily="Consolas" FontSize="13"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 Background="{DynamicResource BrushEditor}"
                 Foreground="{DynamicResource BrushEditorFG}"
                 CaretBrush="{DynamicResource BrushFG}"
                 BorderThickness="0"
                 Padding="6"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Copiar al portapapeles"
                    Margin="0,0,8,0" Click="Copiar_Click"/>
            <Button Content="Cerrar"
                    IsCancel="True" Click="Cerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
